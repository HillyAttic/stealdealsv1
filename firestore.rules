rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Properties: public read, superuser write ───────────────────────────
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == "superuser";
    }

    // ─── Users: self-read, self-write only ───────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Wishlists: owner-only access (subcollection per user) ───────────────
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Activities: owner-only (subcollection per user) ─────────────────────
    match /activities/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Global activities: authenticated read, server-side write only ───────
    match /globalActivities/{activityId} {
      allow read:  if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ─── User activities: flat collection, owner write ────────────────────────
    match /userActivities/{activityId} {
      allow read:  if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // ─── Admin users: self-read, server-side write only ───────────────────────
    match /adminUsers/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Admin SDK only
    }

    // ─── Stats: authenticated read, server-side write only ────────────────────
    match /userStats/{uid} {
      allow read:  if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    match /globalStats/{doc} {
      allow read:  if true;
      allow write: if false; // Admin SDK only
    }

    // ─── System collections: no client access ─────────────────────────────────
    match /_migration/{doc} {
      allow read, write: if false;
    }

    match /_backups/{doc} {
      allow read, write: if false;
    }

    // ─── Catch-all: deny everything else by default ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
