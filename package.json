{
  "name": "stealdeals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "node scripts/clean-restart.js && npm run dev",
    "build": "next build --no-lint",
    "vercel-build": "next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='(unit|core|cache)'",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:e2e": "jest --testPathPattern=e2e --maxWorkers=1",
    "test:stress": "jest --testPathPattern=stress --testTimeout=20000 --maxWorkers=1",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance && npm run test:e2e",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:fix": "node scripts/fix-test-imports.js && jest --clearCache",
    "test:report": "npx ts-node src/__tests__/utils/generateReport.ts",
    "clean": "node scripts/clean-restart.js",
    "validate-env": "node scripts/validate-env.js",
    "deploy": "node scripts/deploy.js",
    "deploy:skip-tests": "node scripts/deploy.js --skip-tests",
    "deploy:verify": "node scripts/post-deploy-verify.js",
    "deploy:full": "npm run validate-env && npm run deploy && npm run deploy:verify"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.1",
    "express-rate-limit": "^8.0.1",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "js-cookie": "^3.0.5",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-quill-new": "^3.6.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "babel-plugin-react-remove-properties": "^0.3.0",
    "cssnano": "^7.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "fake-indexeddb": "^6.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "msw": "^2.2.1",
    "playwright": "^1.42.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.1",
    "typescript": "^5",
    "vitest": "^1.6.1"
  }
}
