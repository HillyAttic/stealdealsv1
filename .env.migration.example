# Firebase Migration Environment Variables
# Copy this to .env.local and fill in your values

# Option 1: Use Firebase Service Account Key (JSON string)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project",...}

# Option 2: Use Application Default Credentials (if running locally with gcloud auth)
# No additional env vars needed - Firebase Admin will use default credentials

# Firebase Project Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stealdeals-e89ab
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://stealdeals-e89ab-default-rtdb.asia-southeast1.firebasedatabase.app/

# Migration Settings
MIGRATION_DRY_RUN=false
MIGRATION_BACKUP_LOCATION=./backups/
MIGRATION_LOG_LEVEL=info