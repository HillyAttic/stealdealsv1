{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "src/app/api/realtime/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/realtime-stats/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/user/activity/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/user/wishlist/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/realtime",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Connection",
          "value": "keep-alive"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Cache-Control, Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/realtime/:path*",
      "destination": "/api/realtime/:path*"
    }
  ]
} 