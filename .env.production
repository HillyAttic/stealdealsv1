# Production Environment Configuration
# This file should be configured on your hosting platform

# Clerk Authentication (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_production_key_here
CLERK_SECRET_KEY=sk_live_your_production_secret_here

# Firebase Configuration (Production)
NEXT_PUBLIC_FIREBASE_API_KEY=your_production_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_production_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_production_project-default-rtdb.region.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_production_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_production_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_production_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_production_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_production_measurement_id

# Application Configuration (Production)
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NODE_ENV=production

# Real-time Configuration (Production Optimized)
REALTIME_HEARTBEAT_INTERVAL=30000
REALTIME_CONNECTION_TIMEOUT=60000
REALTIME_MAX_CONNECTIONS=5000
REALTIME_ENABLE_LOGGING=false

# Activity Tracking Configuration (Production Optimized)
ACTIVITY_BATCH_SIZE=20
ACTIVITY_BATCH_TIMEOUT=3000
ACTIVITY_ENABLE_ANALYTICS=true

# Wishlist Configuration (Production)
WISHLIST_MAX_ITEMS=200
WISHLIST_ENABLE_NOTIFICATIONS=true

# Performance Configuration (Production Optimized)
ENABLE_CACHING=true
CACHE_TTL=600
DATABASE_POOL_SIZE=20

# Security Configuration
JWT_SECRET=your_production_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=24h

# Admin Configuration (Production)
ADMIN_EMAIL=admin@your-production-domain.com
ADMIN_PASSWORD=your_secure_production_admin_password

# Monitoring and Logging
NEXT_TELEMETRY_DISABLED=1
DISABLE_ESLINT_PLUGIN=true
SUPPRESS_DEVELOPMENT_WARNINGS=false